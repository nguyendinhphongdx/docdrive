NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres connection. Local dev: see docker-compose.yml for a ready-to-go DB.
DATABASE_URL=postgresql://docdrive:docdrive@localhost:5432/docdrive?schema=public

# Auth.js secret. Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string

# Required for /api/cron/cleanup endpoint
CRON_SECRET=replace-with-another-long-random-string
